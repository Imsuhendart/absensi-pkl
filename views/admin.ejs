<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel - Manajemen Akun Siswa PKL</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
  <style>
    body { background-color: #f4f7fc; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .card-custom { border: none; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); background: white; }
  </style>
</head>
<body>

  <div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="fw-bold text-dark"><i class="fa-solid fa-user-shield text-primary me-2"></i> Panel Admin Siswa PKL</h2>
        <p class="text-muted mb-0">SMKN 1 Sukaluyu - Kelola Akun dan Data Siswa</p>
      </div>
      <div>
        <a href="/admin/logout" class="btn btn-danger fw-bold"><i class="fa-solid fa-right-from-bracket me-1"></i> Logout Admin</a>
      </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <div class="row">
      <!-- Form Tambah Siswa -->
      <div class="col-md-4 mb-4">
        <div class="card card-custom p-4">
          <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-user-plus me-2"></i> Tambah Siswa Baru</h5>
          <form action="/admin/tambah-siswa" method="POST">
            <div class="mb-3">
              <label class="form-label fw-bold small">Username / NIS</label>
              <input type="text" name="username" class="form-control" placeholder="Contoh: 1234567890" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold small">Password</label>
              <input type="password" name="password" class="form-control" placeholder="Password akun siswa" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold small">Nama Lengkap</label>
              <input type="text" name="nama_lengkap" class="form-control" placeholder="Nama lengkap siswa" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold small">Kelas</label>
              <input type="text" name="kelas" class="form-control" placeholder="Contoh: XI TKJT 1" required>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold small">Jurusan</label>
              <input type="text" name="jurusan" class="form-control" placeholder="Contoh: Teknik Komputer & Jaringan" required>
            </div>
            <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm">
              <i class="fa-solid fa-save me-1"></i> Simpan Siswa
            </button>
          </form>
        </div>
      </div>

      <!-- Daftar Siswa yang Terdaftar -->
      <div class="col-md-8">
        <div class="card card-custom p-4">
          <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-users me-2"></i> Daftar Akun Siswa PKL Terdaftar</h5>
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead class="table-dark">
                <tr>
                  <th>No</th>
                  <th>Username / NIS</th>
                  <th>Nama Lengkap</th>
                  <th>Kelas & Jurusan</th>
                  <th>Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% if (usersList && usersList.length > 0) { %>
                  <% usersList.forEach((user, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td class="fw-bold text-primary"><%= user.username %></td>
                      <td><%= user.nama_lengkap %></td>
                      <td><small class="text-muted"><%= user.kelas %> - <%= user.jurusan %></small></td>
                      <td>
                        <form action="/admin/hapus-siswa" method="POST" onsubmit="return confirm('Yakin ingin menghapus akun ini?');" style="display:inline;">
                          <input type="hidden" name="id" value="<%= user.id %>">
                          <button type="submit" class="btn btn-sm btn-danger"><i class="fa-solid fa-trash"></i></button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="text-center text-muted py-4">Belum ada akun siswa terdaftar.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>