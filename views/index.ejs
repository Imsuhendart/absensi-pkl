<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Absensi PKL' %></title>
  <!-- Bootstrap 5 CSS CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- FontAwesome untuk Ikon -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="#"><i class="fa-solid fa-clipboard-user me-2"></i>Absensi PKL</a>
      <div>
        <% if (typeof user !== 'undefined' && user !== null) { %>
          <span class="text-white me-3"><i class="fa-solid fa-user-circle me-1"></i><%= user.username %> (<%= user.role %>)</span>
          <a href="/logout" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-right-from-bracket me-1"></i>Logout</a>
        <% } else { %>
          <a href="/login" class="btn btn-light btn-sm text-primary fw-bold"><i class="fa-solid fa-right-to-bracket me-1"></i>Login</a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Konten Utama -->
  <div class="container my-5">
    <div class="p-5 mb-4 bg-white rounded-4 shadow-sm border">
      <div class="container-fluid py-2">
        <h1 class="display-6 fw-bold text-dark">Selamat Datang di Sistem Absensi PKL</h1>
        <p class="col-md-8 fs-5 text-secondary">Kelola data kehadiran harian dan unduh laporan rekapitulasi dengan mudah dan cepat.</p>
        <hr class="my-4">
        
        <% if (typeof user !== 'undefined' && user !== null) { %>
          <div class="alert alert-success" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>Anda berhasil masuk sebagai <strong><%= user.username %></strong>. Silakan catat kehadiran Anda hari ini.
          </div>
          <button class="btn btn-success btn-lg shadow-sm"><i class="fa-solid fa-check-to-slot me-2"></i>Absen Sekarang</button>
        <% } else { %>
          <div class="alert alert-warning" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>Silakan <strong>Login</strong> terlebih dahulu untuk melakukan absensi.
          </div>
          <a href="/login" class="btn btn-primary btn-lg shadow-sm"><i class="fa-solid fa-right-to-bracket me-2"></i>Masuk ke Akun</a>
        <% } %>
      </div>
    </div>

    <!-- Tombol Unduh Laporan -->
    <div class="card shadow-sm border-0">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <h5 class="card-title fw-bold text-dark mb-1"><i class="fa-solid fa-file-excel text-success me-2"></i>Laporan Presensi</h5>
          <p class="card-text text-muted mb-0">Unduh rekap data absensi peserta PKL dalam format Excel (CSV).</p>
        </div>
        <a href="#" class="btn btn-outline-success"><i class="fa-solid fa-download me-1"></i>Unduh CSV</a>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="text-center text-muted py-4">
    <small>&copy; 2026 Aplikasi Absensi PKL. All rights reserved.</small>
  </footer>

  <!-- Bootstrap JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>