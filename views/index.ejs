<div class="container my-4">
  <div class="card shadow-sm p-4">
    <h3 class="mb-3">Formulir Presensi Harian PKL</h3>
    
    <form action="/absen" method="POST" enctype="multipart/form-data">
      <!-- Status Keterangan Absen -->
      <div class="mb-3">
        <label class="form-label fw-bold">Keterangan Kehadiran</label>
        <select name="status" class="form-select" required>
          <option value="Hadir">Hadir</option>
          <option value="Izin">Izin</option>
          <option value="Sakit">Sakit</option>
        </select>
      </div>

      <!-- Cek Koordinat GPS Otomatis -->
      <div class="mb-3">
        <label class="form-label fw-bold">Koordinat Lokasi Anda</label>
        <div class="input-group">
          <input type="text" id="lokasi" name="koordinat" class="form-control" readonly placeholder="Mendeteksi lokasi...">
          <button type="button" class="btn btn-outline-secondary" onclick="getLocation()">Perbarui Lokasi</button>
        </div>
        <small class="text-muted">Pastikan izin lokasi (GPS) pada perangkat Anda diaktifkan.</small>
      </div>

      <!-- Upload Foto Bukti -->
      <div class="mb-3">
        <label class="form-label fw-bold">Upload Foto (Selfie / Bukti di Tempat PKL)</label>
        <input type="file" name="foto" class="form-control" accept="image/*" capture="user" required>
      </div>

      <button type="submit" class="btn btn-success w-100"><i class="fa-solid fa-paper-plane me-2"></i>Kirim Absensi</button>
    </form>
  </div>
</div>

<!-- Skrip JavaScript untuk mengambil koordinat GPS otomatis -->
<script>
  function getLocation() {
    const lokasiInput = document.getElementById("lokasi");
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (position) => {
          const lat = position.coords.latitude;
          const lng = position.coords.longitude;
          lokasiInput.value = `${lat}, ${lng}`;
        },
        (error) => {
          lokasiInput.value = "Gagal mendeteksi lokasi (Aktifkan GPS)";
        }
      );
    } else {
      lokasiInput.value = "Geolocation tidak didukung browser ini.";
    }
  }
  // Panggil fungsi saat halaman dimuat
  window.onload = getLocation;
</script>