<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Absensi PKL - SMKN 1 Sukaluyu</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
  <style>
    body { background-color: #f4f7fc; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    .sidebar { width: 260px; min-height: 100vh; background: linear-gradient(180deg, #0d1b2a 0%, #1b263b 100%); color: white; position: fixed; top: 0; left: 0; z-index: 100; padding: 20px; }
    .sidebar .nav-link { color: #a0aec0; border-radius: 8px; margin-bottom: 8px; font-weight: 500; transition: all 0.3s; }
    .sidebar .nav-link:hover, .sidebar .nav-link.active { background-color: #3b82f6; color: white; }
    .main-content { margin-left: 260px; padding: 30px; }
    .card-custom { border: none; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); background: white; }
    @media (max-width: 768px) {
      .sidebar { width: 100%; position: relative; min-height: auto; }
      .main-content { margin-left: 0; padding: 15px; }
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <div class="sidebar d-flex flex-column justify-content-between shadow">
    <div>
      <div class="text-center mb-4">
        <!-- Logo SMKN 1 Sukaluyu (Placeholder / Ganti dengan link gambar logo asli jika ada) -->
        <div class="bg-white rounded-circle p-2 d-inline-block shadow mb-2" style="width: 80px; height: 80px;">
          <i class="fa-solid fa-graduation-cap text-primary fa-2x mt-2"></i>
        </div>
        <h5 class="fw-bold mb-0 text-white">SMKN 1 SUKALUYU</h5>
        <small class="text-info">Absensi PKL</small>
      </div>
      <hr class="border-secondary">
      <ul class="nav flex-column">
        <li class="nav-item"><a href="#" class="nav-link active"><i class="fa-solid fa-chart-pie me-2"></i> Dashboard</a></li>
        <li class="nav-item"><a href="#" class="nav-link"><i class="fa-solid fa-clipboard-user me-2"></i> Absensi</a></li>
        <li class="nav-item"><a href="#" class="nav-link"><i class="fa-solid fa-table-list me-2"></i> Riwayat Absensi</a></li>
        <li class="nav-item"><a href="#" class="nav-link"><i class="fa-solid fa-user-gear me-2"></i> Profil Siswa</a></li>
        <li class="nav-item"><a href="#" class="nav-link"><i class="fa-solid fa-building me-2"></i> Perusahaan</a></li>
      </ul>
    </div>
    <div>
      <hr class="border-secondary">
      <a href="/logout" class="nav-link text-danger fw-bold"><i class="fa-solid fa-right-from-bracket me-2"></i> Logout</a>
    </div>
  </div>

  <!-- Main Content -->
  <div class="main-content">
    <% if (typeof user !== 'undefined' && user !== null) { %>
      
      <!-- Top Banner Header -->
      <div class="card card-custom p-4 mb-4 bg-gradient text-white" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h2 class="fw-bold mb-1">ABSENSI PKL</h2>
            <h4 class="text-light mb-2">SMKN 1 SUKALUYU</h4>
            <p class="mb-0 text-white-50">Sistem Absensi Praktik Kerja Lapangan Berbasis Lokasi GPS</p>
          </div>
          <div class="text-end bg-white text-dark p-3 rounded-4 shadow-sm">
            <span class="d-block fw-bold text-primary"><i class="fa-solid fa-user-shield me-1"></i> <%= user.username %></span>
            <small class="text-muted">Siswa PKL</small>
          </div>
        </div>
      </div>

      <!-- Info Siswa & Perusahaan -->
      <div class="row mb-4">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="card card-custom p-4 h-100">
            <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-user-graduate me-2"></i>DATA SISWA</h5>
            <div class="d-flex align-items-center">
              <div class="bg-light rounded-circle p-3 me-3 text-center" style="width: 70px; height: 70px;">
                <i class="fa-solid fa-user fa-2x text-secondary mt-1"></i>
              </div>
              <div>
                <p class="mb-1"><strong>Nama:</strong> <%= user.username %></p>
                <p class="mb-1"><strong>Kelas:</strong> XI TKJT 1</p>
                <p class="mb-0"><strong>Jurusan:</strong> Teknik Komputer & Jaringan</p>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card card-custom p-4 h-100">
            <h5 class="fw-bold text-success mb-3"><i class="fa-solid fa-building-columns me-2"></i>DATA PERUSAHAAN / INSTANSI</h5>
            <p class="mb-1"><strong>Perusahaan:</strong> PT. Mitra Teknologi Mandiri</p>
            <p class="mb-1"><strong>Pembimbing:</strong> Budi Santoso, S.T.</p>
            <p class="mb-0"><strong>Lokasi:</strong> Jl. Raya Sukaluyu No. 123, Cianjur</p>
          </div>
        </div>
      </div>

      <!-- Form Tombol Absen Hari Ini -->
      <div class="card card-custom p-4 mb-4">
        <h4 class="fw-bold text-dark mb-3"><i class="fa-solid fa-calendar-days me-2 text-primary"></i>ABSENSI HARI INI</h4>
        <form action="/absen" method="POST">
          <input type="hidden" name="username" value="<%= user.username %>">
          
          <div class="row align-items-center mb-4">
            <div class="col-md-4 mb-3 mb-md-0">
              <label class="form-label fw-bold">Pilih Status Kehadiran:</label>
              <select name="status" class="form-select form-select-lg" required>
                <option value="Hadir">Hadir</option>
                <option value="Izin">Izin</option>
                <option value="Sakit">Sakit</option>
              </select>
            </div>
            <div class="col-md-8">
              <label class="form-label fw-bold">Koordinat Lokasi GPS Anda:</label>
              <div class="input-group">
                <input type="text" id="lokasi" name="koordinat" class="form-control" readonly placeholder="Mendeteksi GPS...">
                <button type="button" class="btn btn-outline-secondary" onclick="getLocation()"><i class="fa-solid fa-location-crosshairs"></i> Refresh</button>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-2">
              <button type="submit" name="tipe" value="Masuk" class="btn btn-success btn-lg w-100 fw-bold py-3 shadow-sm">
                <i class="fa-solid fa-right-to-bracket me-2"></i> ABSEN MASUK
              </button>
            </div>
            <div class="col-md-6">
              <button type="submit" name="tipe" value="Pulang" class="btn btn-primary btn-lg w-100 fw-bold py-3 shadow-sm">
                <i class="fa-solid fa-right-from-bracket me-2"></i> ABSEN PULANG
              </button>
            </div>
          </div>
        </form>
      </div>

    <% } else { %>
      <!-- Tampilan Jika Belum Login (Dialihkan otomatis atau tombol ke login) -->
      <div class="text-center py-5">
        <div class="card card-custom p-5 mx-auto shadow-lg" style="max-width: 500px;">
          <div class="bg-primary text-white rounded-circle p-4 d-inline-block mx-auto mb-3 shadow">
            <i class="fa-solid fa-school fa-3x"></i>
          </div>
          <h2 class="fw-bold text-dark">SMKN 1 SUKALUYU</h2>
          <p class="text-muted mb-4">Sistem Absensi Praktik Kerja Lapangan (PKL)</p>
          <a href="/login" class="btn btn-primary btn-lg w-100 fw-bold py-3 rounded-pill shadow">
            <i class="fa-solid fa-right-to-bracket me-2"></i> Masuk / Login Aplikasi
          </a>
        </div>
      </div>
    <% } %>

    <!-- Tabel Riwayat Absensi -->
    <div class="card card-custom p-4">
      <h4 class="fw-bold text-dark mb-3"><i class="fa-solid fa-history me-2 text-dark"></i>Riwayat Absensi Anda</h4>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-dark">
            <tr>
              <th>Waktu / Tanggal</th>
              <th>Nama</th>
              <th>Status</th>
              <th>Koordinat GPS</th>
            </tr>
          </thead>
          <tbody>
            <% if (absensiList && absensiList.length > 0) { %>
              <% absensiList.forEach(item => { %>
                <tr>
                  <td><%= new Date(item.created_at).toLocaleString('id-ID') %></td>
                  <td class="fw-bold"><%= item.username %></td>
                  <td>
                    <span class="badge <%= item.status === 'Hadir' ? 'bg-success' : (item.status === 'Izin' ? 'bg-warning text-dark' : 'bg-danger') %>">
                      <%= item.status %>
                    </span>
                  </td>
                  <td><small class="text-muted"><%= item.koordinat %></small></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" class="text-center text-muted py-4">Belum ada riwayat absensi tercatat.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Skrip GPS -->
  <script>
    function getLocation() {
      const lokasiInput = document.getElementById("lokasi");
      if (navigator.geolocation) {
        lokasiInput.value = "Mencari koordinat GPS...";
        navigator.geolocation.getCurrentPosition(
          (position) => {
            const lat = position.coords.latitude.toFixed(6);
            const lng = position.coords.longitude.toFixed(6);
            lokasiInput.value = `${lat}, ${lng}`;
          },
          (error) => {
            lokasiInput.value = "Gagal mendeteksi lokasi (Aktifkan GPS)";
          },
          { enableHighAccuracy: true }
        );
      } else {
        lokasiInput.value = "Geolocation tidak didukung browser ini.";
      }
    }
    window.onload = getLocation;
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>